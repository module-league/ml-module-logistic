{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=(localdb)\\MSSQLLocalDB;Initial Catalog=ML_Logistic;Integrated Security=True"
  },
  "AttachmentStorage": {
    "Path": "App_Data/attachments",
    "MaxBytes": 15728640
  },
  "Dispatch": {
    "ShipmentSidebarId": "shipment",
    "DriverSidebarId": "shipment-driver",
    "VehicleSidebarId": "shipment-vehicle",
    "LocationSidebarId": "shipment-location"
  },
  "ExceptionRules": {
    "TimeZone": "Asia/Kuala_Lumpur",
    "Rules": [
      { "RuleKey": "delayed", "Title": "Delayed", "When": "now > dueTime + grace AND status != delivered", "Type": "delay", "Severity": "high", "SlaMinutes": 60, "GracePeriodMinutes": 0, "AutoClose": true, "IsActive": true, "Reasons": [ "New ETA agreed with carrier", "Delivered, status not updated", "Cancelled by customer", "Reassigned to another driver" ] },
      { "RuleKey": "late_pickup", "Title": "Late pickup", "When": "status = planned AND now > plannedPickup + grace", "Type": "late_pickup", "Severity": "high", "SlaMinutes": 15, "GracePeriodMinutes": 30, "AutoClose": true, "IsActive": true, "Reasons": [ "Driver on the way", "Reassigned to another driver", "Pickup rescheduled", "Picked up, not recorded" ] },
      { "RuleKey": "missing_destination", "Title": "Missing destination", "When": "destination IS EMPTY AND no dispatch AND now > booked + grace", "Type": "missing_destination", "Severity": "medium", "SlaMinutes": 240, "GracePeriodMinutes": 10, "AutoClose": true, "IsActive": true, "Reasons": [ "Destination linked", "Shipment cancelled" ] },
      { "RuleKey": "missing_document", "Title": "Missing document", "When": "status = planned AND papers that gate picked_up NOT verified", "Type": "missing_document", "Severity": "high", "SlaMinutes": 60, "GracePeriodMinutes": 0, "AutoClose": true, "IsActive": true, "Reasons": [ "Document verified", "Not required for this shipment" ] },
      { "RuleKey": "weight_mismatch", "Title": "Weight mismatch", "When": "abs(pickupWeight - chargeableWeight) / chargeableWeight > tolerance", "Type": "weight_mismatch", "Severity": "medium", "SlaMinutes": 120, "GracePeriodMinutes": 0, "AutoClose": true, "IsActive": true, "TolerancePercent": 5, "Reasons": [ "Used the pickup weight", "Kept the record weight", "Reweighed, within tolerance" ] },
      { "RuleKey": "arrived_before_opening", "Title": "Arrived before opening", "When": "status = arrived AND arrivedAt < destination.operatingHourStart", "Type": "early_arrival", "Severity": "low", "SlaMinutes": 30, "GracePeriodMinutes": 0, "AutoClose": true, "IsActive": true, "Reasons": [ "Waited and delivered", "Receiver opened early", "Rescheduled delivery" ] },
      { "RuleKey": "delivery_attempt_failed", "Title": "Delivery attempt failed", "When": "raised by the driver or dispatcher", "Type": "failed_delivery", "Severity": "high", "SlaMinutes": 60, "GracePeriodMinutes": 0, "AutoClose": false, "IsActive": true, "Manual": true, "Reasons": [ "Redelivered", "Rescheduled delivery", "Returned to origin" ] },
      { "RuleKey": "pod_not_verified", "Title": "POD not verified", "When": "status = delivered AND papers that gate billed NOT verified", "Type": "pod_not_verified", "Severity": "medium", "SlaMinutes": 1440, "GracePeriodMinutes": 0, "AutoClose": true, "IsActive": true, "Reasons": [ "POD verified", "POD not needed" ] },
      { "RuleKey": "manual", "Title": "Other problem", "When": "raised by hand", "Type": "other", "Severity": "medium", "SlaMinutes": 240, "GracePeriodMinutes": 0, "AutoClose": false, "IsActive": true, "Manual": true, "Reasons": [ "Fixed", "Customer informed" ] }
    ]
  },
  "DocumentReview": {
    "Model": "claude-haiku-5-5",
    "Effort": "low",
    "MaxTokens": 16000,
    "TolerancePercent": 5,
    "MinConfidence": 60
  },
  "Billing": {
    "PartySidebarId": "shipment-party",
    "Currency": "MYR",
    "CurrencySymbol": "RM",
    "TaxPercent": 6,
    "FreightTaxable": true,
    "DefaultCreditTermsDays": 30,
    "Issuer": { "Name": "Module League Logistics Sdn Bhd", "RegistrationNo": "202601000001 (1234567-X)", "TaxId": "C1234567890", "Address": "Lot 1, Jalan Logistik, 40000 Shah Alam, Selangor" },
    "PayerByIncoterm": { "EXW": "consignee", "FCA": "consignee", "FAS": "consignee", "FOB": "consignee", "CPT": "shipper", "CIP": "shipper", "CFR": "shipper", "CIF": "shipper", "DAP": "shipper", "DPU": "shipper", "DDP": "shipper" },
    "RateCards": [
      { "Name": "Air Klang to Shah Alam", "Mode": "Air", "FromZone": "MY-KLANG-01", "ToZone": "MY-SHAH-02", "RatePerKg": 6.80, "MinCharge": 150, "FuelPct": 12, "Currency": "MYR", "ValidFrom": "2026-01-01" },
      { "Name": "Air Shah Alam to Klang", "Mode": "Air", "FromZone": "MY-SHAH-02", "ToZone": "MY-KLANG-01", "RatePerKg": 6.80, "MinCharge": 150, "FuelPct": 12, "Currency": "MYR", "ValidFrom": "2026-01-01" },
      { "Name": "Sea any lane", "Mode": "Sea", "FromZone": "*", "ToZone": "*", "RatePerKg": 1.20, "MinCharge": 300, "FuelPct": 8, "Currency": "MYR", "ValidFrom": "2026-01-01" },
      { "Name": "Land any lane", "Mode": "Land", "FromZone": "*", "ToZone": "*", "RatePerKg": 0.85, "MinCharge": 120, "FuelPct": 6, "Currency": "MYR", "ValidFrom": "2026-01-01" }
    ],
    "ChargeTypes": [
      { "Key": "fuel_surcharge", "Title": "Fuel surcharge", "Basis": "percent_of_freight", "Taxable": true, "Automatic": true },
      { "Key": "handling", "Title": "Handling", "Basis": "flat", "BasisText": "Flat per shipment", "DefaultAmount": 45, "Taxable": true, "Automatic": true },
      { "Key": "documentation", "Title": "Documentation", "Basis": "flat", "BasisText": "Per document set", "DefaultAmount": 25, "Taxable": true, "Automatic": true },
      { "Key": "waiting_time", "Title": "Waiting time", "Basis": "per_hour", "DefaultAmount": 40, "Taxable": true, "FromRule": "arrived_before_opening", "FromReasons": [ "Waited and delivered", "Condition cleared" ] },
      { "Key": "failed_attempt", "Title": "Failed delivery attempt", "Basis": "flat", "BasisText": "Per attempt", "DefaultAmount": 60, "Taxable": true, "FromRule": "delivery_attempt_failed" },
      { "Key": "redelivery", "Title": "Redelivery", "Basis": "flat", "BasisText": "Per redelivery", "DefaultAmount": 80, "Taxable": true, "FromRule": "delivery_attempt_failed", "FromReasons": [ "Redelivered" ] }
    ]
  }
}
